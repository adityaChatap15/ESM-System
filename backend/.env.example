# Copy this file to .env and adjust as needed for local development.

DATABASE_URL=postgresql://esm_user:esm_password@localhost:5433/esm_db
JWT_SECRET_KEY=change-me-in-production

# Comma-separated frontend origin(s) allowed to call this API. Leave as "*"
# for local dev; set to the real Vercel URL(s) in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://esm-frontend.vercel.app
CORS_ALLOWED_ORIGINS=*
